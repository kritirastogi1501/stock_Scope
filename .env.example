# StockScope AI — frontend (root) environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# Only VITE_-prefixed variables are exposed to the browser bundle — keep
# secrets (Supabase service role key, Alpha Vantage key) in server/.env instead.

# Backend API layer (server/) — proxies the market data provider and caching
VITE_API_BASE_URL=http://localhost:8787/api

# Supabase project — the ANON/public key only. It is safe to ship in the
# frontend bundle because table access is governed by Row Level Security
# policies (see supabase/migrations/001_init_schema.sql), not by keeping
# this key secret.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# StockScope AI — backend (server/) environment variables
# Copy this file to server/.env and fill in real values. Never commit server/.env.

# Market data provider (Alpha Vantage — see server/services/alphaVantage.js)
MARKET_API_KEY=

# Supabase project credentials — SERVICE ROLE key only, used server-side
# for writing/caching provider data. This key bypasses Row Level Security
# and must never be sent to the browser or committed to source control.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Backend server
PORT=8787
CORS_ORIGIN=http://localhost:5173
